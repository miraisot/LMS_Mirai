NEXT_PUBLIC_LMS_NAME=Mirai School of Technology
NEXT_PUBLIC_LMS_TAGLINE=An AI-first B.Tech experience — lectures, readings, and quizzes from Day 1.
NEXT_PUBLIC_INSTITUTION=Mirai School of Technology
NEXT_PUBLIC_STUDENT_NAME=Student
NEXT_PUBLIC_LMS_LOGO=/mirai-logo.svg

# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth is handled by Supabase (no secret needed here).
# 1. Enable the Google provider in Supabase: Authentication > Providers > Google.
# 2. Create an OAuth 2.0 Client ID in Google Cloud Console; set the authorized
#    redirect URI to the one Supabase shows (…/auth/v1/callback).
# 3. Paste the Google Client ID and Secret into the Supabase provider panel.
# 4. In Supabase Authentication > URL Configuration, add this app's origin
#    (e.g. http://localhost:3000) to "Site URL" and the full
#    "<origin>/auth/callback" to "Redirect URLs".
